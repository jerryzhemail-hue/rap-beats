# ============================================================
# ⚠️ 本地开发环境配置模板
#
# 用法(在新机器或 clone 后):
#   1) cp server/.env.dev.example server/.env
#   2) 按需修改 JWT_SECRET / OSS_* 等真实配置
#   3) cd server && npm install && npm run dev
#
# 这套默认对接 docker-compose.dev.yml 起容器:
#   - rap-beats-dev-mysql (端口 3307, 健康检查通过)
#   - user=dev_user, password=dev_pass_2024
#   - DB_NAME=rap_beats_dev
#   - FORUM_DB_NAME=rap_beats_forum(论坛子库,独立容器或共享容器)
#
# 如果想用 Homebrew MySQL(端口 3306, root 密码),
# 改 DB_PORT=3306、DB_USER=root、DB_PASSWORD=你的密码,
# 并把 DB_NAME 改为 *_dev 后缀(切勿连线上库)。
# ============================================================

# ------------------------------------------------------
# MySQL 数据库(本地开发)
# ------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=dev_user
DB_PASSWORD=dev_pass_2024
DB_NAME=rap_beats_dev
DB_POOL_SIZE=10

# ------------------------------------------------------
# 论坛独立数据库(本地开发)
# ------------------------------------------------------
FORUM_DB_HOST=127.0.0.1
FORUM_DB_PORT=3307
FORUM_DB_USER=dev_user
FORUM_DB_PASSWORD=dev_pass_2024
FORUM_DB_NAME=rap_beats_forum

# ------------------------------------------------------
# JWT 认证(本地用占位,生产必须重新生成)
# 生成方法:node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------
JWT_SECRET=dev-jwt-secret-do-not-use-in-prod-0123456789abcdef0123456789abcdef

# ------------------------------------------------------
# 域名配置(本地开发)
# ------------------------------------------------------
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------
# 存储配置(本地用 local,不要消耗 OSS 流量)
# ------------------------------------------------------
STORAGE_DRIVER=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=

# ------------------------------------------------------
# 本地文件存储路径
# ------------------------------------------------------
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------
# 虎皮椒支付(本地不需要,留空即可)
# ------------------------------------------------------
XUNHU_APPID=
XUNHU_APPSECRET=
XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html