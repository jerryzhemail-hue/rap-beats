# ============================================================
# 虎皮椒支付（必须配置）
# ============================================================
XUNHU_APPID=your-app-id-from-xunhupay
XUNHU_APPSECRET=your-app-secret-from-xunhupay

# 虎皮椒网关（国内版用这个，海外版换地址）
XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html

# ============================================================
# JWT 认证（生产环境必须重新生成，不能用示例值）
# 生成方法：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=replace-with-a-64-char-random-string

# ============================================================
# 域名配置（生产环境必须修改）
# BASE_URL：后端地址，支付回调会回调这个地址
# CLIENT_URL：前端地址，用于拼接支付成功跳转
# ============================================================
BASE_URL=https://your-backend-domain.com
CLIENT_URL=https://your-frontend-domain.com

# ============================================================
# 存储配置
# local：文件存在本地 server/uploads/（仅本地开发使用）
# oss：文件存阿里云 OSS（生产环境推荐）
# ============================================================
# STORAGE_DRIVER=local
STORAGE_DRIVER=oss

# 阿里云 OSS（STORAGE_DRIVER=oss 时必须配置）
OSS_REGION=oss-cn-beijing
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-aliyun-access-key-id
OSS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-cdn-domain.com

# OSS 内路径前缀（不需要改）
OSS_AUDIO_PREFIX=audio
OSS_COVER_PREFIX=covers
OSS_AVATAR_PREFIX=avatars

# ============================================================
# MySQL 数据库（生产环境必须修改）
# ============================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-strong-db-password
DB_NAME=rap_beats

# ============================================================
# 论坛独立数据库（可选，不配置则与主库共用）
# 仅当 FORUM_DB_NAME 设置时生效
# ============================================================
# FORUM_DB_HOST=127.0.0.1
# FORUM_DB_PORT=3306
# FORUM_DB_USER=your-forum-db-user
# FORUM_DB_PASSWORD=your-forum-db-password
# FORUM_DB_NAME=rap_beats_forum

# ============================================================
# SQLite（仅本地开发或迁移排查时使用，生产禁止开启）
# ============================================================
# DB_DRIVER=sqlite
