# ============================================================
# 本地测试环境（独立于 dev/prod，使用 *_test 库避免污染）
#
# 用法：先确保 3307 dev mysql 在跑，然后
#   mysql -h 127.0.0.1 -P 3307 -uroot -pdev_root_2024 <<SQL
#     CREATE DATABASE IF NOT EXISTS rap_beats_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS rap_beats_forum_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS rap_beats_membership_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL PRIVILEGES ON rap_beats_test.* TO 'dev_user'@'%';
#     GRANT ALL PRIVILEGES ON rap_beats_forum_test.* TO 'dev_user'@'%';
#     GRANT ALL PRIVILEGES ON rap_beats_membership_test.* TO 'dev_user'@'%';
#     FLUSH PRIVILEGES;
#   SQL
# 然后 cd server && npm test
# ============================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=dev_user
DB_PASSWORD=dev_pass_2024
DB_NAME=rap_beats_test
DB_POOL_SIZE=10

FORUM_DB_NAME=rap_beats_forum_test
MEMBERSHIP_DB_NAME=rap_beats_membership_test

JWT_SECRET=test-jwt-secret-do-not-use-in-prod-0123456789abcdef0123456789abcdef

STORAGE_DRIVER=local
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
NODE_ENV=test
RATE_LIMIT_DISABLED=true
MOCK_PAYMENT_ENABLED=true

# beatmaker 加密密钥（CI/local 测试用固定占位，提交到仓库不算秘密）
# 生产环境必须用完全不同的高熵随机串（生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"）
BEATMAKER_IDCARD_KEY=local-test-beatmaker-idcard-key-please-rotate-in-prod
BEATMAKER_IDCARD_PEPPER=local-test-beatmaker-idcard-pepper-please-rotate-in-prod
