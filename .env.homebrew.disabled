# ============================================================
# ⚠️  此文件已废弃,不要再编辑!任何修改都不会生效。
#
#     后端从 server/ 目录启动时, dotenv 默认只读 server/.env。
#     这个文件保留仅为历史参考(早期 Homebrew MySQL 方案)。
#
#     当前生效的配置:
#       → server/.env    (连 docker 容器 rap-beats-dev-mysql:3307)
#          DB_NAME=rap_beats_dev
#          FORUM_DB_NAME=rap_beats_forum
#
#     如果你看到这一行,说明你在错误的文件上做修改。
#     请改 server/.env,改完重启后端 (npm run dev)。
# ============================================================
#
# 历史:这套配置对应的是「Homebrew MySQL」开发方式
#    - DB_PORT=3306(macOS 本机 MySQL 默认端口)
#    - DB_USER=root(Homebrew 默认 root 用户)
#    - DB_PASSWORD=你的本地 root 密码
#
# 如果你用的是「Docker MySQL」(推荐,./deploy.sh local),
# 请改用 server/.env,那套连的是 docker-compose.dev.yml 起的容器(端口 3307)。
#
# 两套二选一,不要同时存在导致 dotenv 加载混乱:
#   方案 A(推荐):docker compose -f docker-compose.dev.yml up -d mysql
#                   cd server && npm run dev   ← 走 server/.env
#   方案 B(Homebrew):brew services start mysql
#                   npm run dev                ← 走根目录 .env
# ============================================================

# ------------------------------------------------------
# 数据库（本地 Homebrew MySQL）
# ------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Wangzhe.Q5@2024
DB_NAME=rap_beats_dev
FORUM_DB_NAME=rap_beats_forum_dev

# ------------------------------------------------------
# JWT 认证（本地开发用，随便填）
# ------------------------------------------------------
JWT_SECRET=dev_jwt_secret_12345678901234567890123456789012345678901234567890

# ------------------------------------------------------
# 虎皮椒支付（本地不需要，可留空）
# ------------------------------------------------------
XUNHU_APPID=
XUNHU_APPSECRET=
XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html

# ------------------------------------------------------
# 域名配置
# ------------------------------------------------------
BASE_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------
# 存储配置（本地开发使用 local 模式，不上传到 OSS）
# ------------------------------------------------------
STORAGE_DRIVER=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=

# ------------------------------------------------------
# 本地文件存储路径
# ------------------------------------------------------
UPLOAD_DIR=./data/uploads
