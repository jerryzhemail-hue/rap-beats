<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rapbeats.bpm-sidecar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/wangzhe/Documents/work/rap-beats/bpm_service/server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/wangzhe/Documents/work/rap-beats/bpm_service</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>5050</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/rap-beats-sidecar.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/rap-beats-sidecar.log</string>
</dict>
</plist>
