# ============================================================
# 阶段一：构建 TypeScript
# ============================================================
FROM node:20-alpine AS server-builder

WORKDIR /app

# 安装依赖（包括 devDependencies，用于构建）
COPY server/package.json server/package-lock.json* ./
RUN npm ci

# 复制源码并编译（shared 是前后端共享类型，server 编译时依赖 @shared/forum）
COPY server/tsconfig.json ./
COPY server/src ./src
COPY shared ./shared
RUN npm run build

# ============================================================
# 阶段二：运行时镜像
# ============================================================
FROM node:20-alpine AS server

WORKDIR /app

# 音频处理：游客试听截断（ffmpeg）+ BPM 检测（ffmpeg 解码，JS 算法）
RUN apk add --no-cache ffmpeg

# 使用非 root 用户提升安全性
RUN addgroup -g 1001 -S nodejs && adduser -S nodeapp -u 1001

# 复制编译产物
COPY --from=server-builder /app/dist ./dist
COPY --from=server-builder /app/node_modules ./node_modules
COPY --from=server-builder /app/package.json ./package.json

# 创建上传目录和数据目录（app 用户可写）
RUN mkdir -p /app/uploads/audio /app/uploads/covers /app/uploads/avatars \
             /app/data/audio /app/data/covers /app/data/avatars /app/data/banners \
             /app/data/forum-images /app/data/forum-audio /app/data/forum \
    && chown -R nodeapp:nodejs /app/uploads /app/data

# 切换到非 root 用户
USER nodeapp

EXPOSE 3000

# 业务时区：项目统一使用 Asia/Shanghai。所有 toDateTimeString / DATE() 比较都依赖此值。
# 不设此项时 Node 容器默认 UTC，会与 MySQL 容器的 TZ 不一致，导致签到/每日积分
# 在跨日（北京时间 08:00 / UTC 00:00）出现"昨天与今天混算"的 bug。
ENV TZ=Asia/Shanghai

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["node", "dist/index.js"]
