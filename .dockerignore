# ============================================================
# 通用
# ============================================================
**/.git
**/.gitignore
**/.DS_Store
**/*.md
**/README.md
**/CHANGELOG.md
**/node_modules

# ============================================================
# 不需要进镜像的文件
# ============================================================
**/dist-ssr
**/*.local
**/*.log
**/npm-debug.log*
**/coverage
**/.vscode
**/.idea
**/*.suo
**/*.ntvs*
**/*.sw?

# ============================================================
# 服务器端
# ============================================================
server/src/scripts
server/src/**/*.test.ts
server/src/**/*.spec.ts
server/.env
!server/.env.example
server/data
server/logs

# ============================================================
# 客户端
# ============================================================
client/src/**/*.spec.ts
client/src/**/*.test.ts
client/coverage
client/*.local

# ============================================================
# Docker 相关（不要把自己 COPY 进镜像）
# ============================================================
docker-compose*.yml
docker-compose*.override.yml
Dockerfile*
.dockerignore
.docker/
deploy.sh
deploy-prod.sh
