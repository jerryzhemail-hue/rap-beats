# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment variables (contains secrets)
.env
.env.local
.env.*.local
*.env
.env.production
.env.*.production
!.env.example
!server/.env.example

# Database (contains user data)
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# Runtime uploads (avatars/covers/audio/forum-* — 由 Express 静态托管，不入仓)
server/data/avatars/
server/data/covers/
server/data/audio/
server/data/banners/
server/data/forum-images/
server/data/forum-audio/
server/data/forum-video/

# Logs
logs/
*.log
npm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db

# Debug logs
.dbg/

# SSH deploy keys (never commit)
.github/deploy_key
.github/deploy_key.pub

# 生产环境变量（含密钥，严禁提交）
.env.production
.env.*.production
!.env.example
!server/.env.example
test_audio/
server/scripts/bpm_*.mjs

# Local DB backups (not for version control — 任何 .sql / .dump / .tar.gz 都忽略)
backups/
!backups/.gitkeep
